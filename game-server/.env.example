# Application Environment Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration (example)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=game_server
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Configuration (example)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# API Configuration
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here

# External Services (example)
EXTERNAL_API_URL=http://localhost:3000
EXTERNAL_API_TIMEOUT=5000

# Rate Limiting (example)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Word Chain (词链接龙) - /api/v1 rate limit + rules (game-design/word-chain-game-design.md)
WORD_CHAIN_RATE_LIMIT_WINDOW_MS=60000
WORD_CHAIN_RATE_LIMIT_MAX=10
WORD_CHAIN_MAX_CHAIN_LENGTH=10
# 只有部署在可信网关之后才开启: 否则客户端可伪造 X-Forwarded-For 绕过限流
TRUST_PROXY_HEADER=false

# Verbose logging
ENABLE_PERFORMANCE_LOG=false
ENABLE_AUDIT_LOG=false
