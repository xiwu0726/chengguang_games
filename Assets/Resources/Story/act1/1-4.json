          "insomnia": 3,
          "flag": "looked_for_the_nail_hole",
          "next": "",
          "affectionWho": ""
        },
        {
          "text": "不找。它已经不在了",
          "affection": 0,
          "insomnia": -1,
          "flag": "accepted_the_clock_was_gone",
          "next": "",
