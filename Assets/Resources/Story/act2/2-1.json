          "text": "回应那个女孩：把「你终于来了」接住",
          "affectionWho": "",
          "affection": 0,
          "insomnia": 0,
          "flag": "answered_the_girl_in_xyas_voice",
          "next": ""
        },
        {
          "text": "回头看身后的小雅。她还在不在",
          "affectionWho": "小雅",
          "affection": 3,
          "insomnia": 0,
          "flag": "turned_to_check_on_xya",
          "next": ""
