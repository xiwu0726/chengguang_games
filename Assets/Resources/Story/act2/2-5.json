    {
      "type": "dialogue",
      "speaker": "艾莉丝",
      "sprite": "alice_cold",
      "text": "把这些点和裂缝的位置叠起来看。如果它们是同一件事的两面，图会告诉我们往哪边走。"
    },
    {
      "type": "narration",
      "text": "中午我们在大厅里吃了带的面包。小雅一边吃一边在本子封面上写字，写完给我看。她写的是：「我不是听鬼的人。我是听没被算进去的人。」"
    },
    {
      "type": "choice",
      "text": "",
      "prompt": "她把那句话写在本子封面上。要不要抄？",
      "options": [
        {
          "text": "原样抄进自己的本子",
          "affectionWho": "",
          "affection": 0,
          "insomnia": 0,
          "flag": "copied_the_line_from_her_cover",
          "next": ""
